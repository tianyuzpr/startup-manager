<Window x:Class="StartupManager.Dialogs.ImpactPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:StartupManager.Localization"
        Title="{Binding OperationName}"
        Width="760"
        Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource InkBrush}">
    <Grid Margin="22">
        <Border Background="{DynamicResource PanelBrush}"
                CornerRadius="20"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36"
                                  ShadowDepth="10"
                                  Opacity="0.24"
                                  Color="{DynamicResource DialogShadowColor}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="26,20,16,12"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                      Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="{Binding OperationName}"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource WindowControlButton}"
                            Width="34"
                            Height="30"
                            Click="Cancel_Click">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="10" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Foreground="{DynamicResource InkBrush}"
                              Padding="26,0,20,0">
                    <StackPanel Margin="0,4,6,10">
                        <TextBlock Text="{loc:Loc 将影响的启动项}"
                                   Style="{StaticResource SectionText}"
                                   FontSize="12" />
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelSecondaryBrush}"
                                            BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Top"
                                                          Margin="0,1,8,0" />
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource InkBrush}" />
                                                        <TextBlock Text="{Binding CategoryLabel}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   Margin="8,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding StateTransition}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding ProtectedReason}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource WarningBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,10,0,0"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Background="{DynamicResource SoftDangerBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,10,0,0"
                                Visibility="{Binding BlockedVisibility}">
                            <TextBlock Text="{Binding BlockedMessage}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Background="{DynamicResource PanelSecondaryBrush}"
                                BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,10,0,0"
                                Visibility="{Binding SnapshotVisibility}">
                            <TextBlock Text="{loc:Loc 删除前会在本地保存一份项目快照。}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Visibility="{Binding TypedVisibility}" Margin="0,14,0,0">
                            <TextBlock Text="{Binding TypedPrompt}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextWrapping="Wrap" />
                            <TextBox x:Name="TypedBox"
                                     Style="{StaticResource InputTextBox}"
                                     Margin="0,8,0,0"
                                     TextChanged="TypedBox_TextChanged" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="26,10,26,20">
                    <TextBlock x:Name="ErrorText"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="10.5"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,150,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc 取消}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="88"
                                Click="Cancel_Click" />
                        <Button x:Name="ConfirmButton"
                                Content="{loc:Loc 确认执行}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="104"
                                Margin="8,0,0,0"
                                Click="Confirm_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
