<Window x:Class="StartupManager.Dialogs.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:StartupManager.Localization"
        Title="{loc:Loc 启动项变更}"
        Width="840"
        Height="780"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource InkBrush}">
    <Grid Margin="22">
        <Border Background="{DynamicResource PanelBrush}"
                CornerRadius="20"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36"
                                  ShadowDepth="10"
                                  Opacity="0.24"
                                  Color="{DynamicResource DialogShadowColor}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="26,20,16,12"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                      Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc 启动项变更}"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc 只读对比，不会执行任何操作。}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource WindowControlButton}"
                            Width="34"
                            Height="30"
                            Click="Close_Click">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="10" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Foreground="{DynamicResource InkBrush}"
                              Padding="26,0,20,0">
                    <StackPanel Margin="0,4,6,10">
                        <TextBlock Text="{Binding SummaryText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="{Binding UnchangedText}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="2,5,0,0" />

                        <Border Background="{DynamicResource PanelSecondaryBrush}"
                                BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,16,0,0"
                                Visibility="{Binding BaselineVisibility}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc 基线已建立}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="{loc:Loc 这是第一次快照，没有可对比的历史，因此不会显示全量新增。}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelSecondaryBrush}"
                                BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,16,0,0"
                                Visibility="{Binding NoChangesVisibility}">
                            <TextBlock Text="{loc:Loc 没有变更。本次扫描结果与当前基线一致。}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Visibility="{Binding AddedVisibility}" Margin="0,18,0,0">
                            <TextBlock Text="{loc:Loc 新增}"
                                       Style="{StaticResource SectionText}"
                                       FontSize="13" />
                            <ItemsControl ItemsSource="{Binding Diff.Added}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelSecondaryBrush}"
                                                BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,7">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkBrush}" />
                                                    <TextBlock Text="{Binding CategoryLabel}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               Margin="8,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding CommandLine}"
                                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource CodeTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding RemovedVisibility}" Margin="0,12,0,0">
                            <TextBlock Text="{loc:Loc 已移除}"
                                       Style="{StaticResource SectionText}"
                                       FontSize="13" />
                            <ItemsControl ItemsSource="{Binding Diff.Removed}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelSecondaryBrush}"
                                                BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,7">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkBrush}" />
                                                    <TextBlock Text="{Binding CategoryLabel}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               Margin="8,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding CommandLine}"
                                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource CodeTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ModifiedVisibility}" Margin="0,12,0,0">
                            <TextBlock Text="{loc:Loc 已修改}"
                                       Style="{StaticResource SectionText}"
                                       FontSize="13" />
                            <ItemsControl ItemsSource="{Binding Diff.Modified}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelSecondaryBrush}"
                                                BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,7">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InkBrush}" />
                                                    <TextBlock Text="{Binding CategoryLabel}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               Margin="8,2,0,0" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Changes}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="78" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding FieldLabel}"
                                                                           Style="{StaticResource CaptionText}"
                                                                           FontSize="10" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding OldValue}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource MutedBrush}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text=" → "
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource AccentBrush}" />
                                                                    <TextBlock Text="{Binding NewValue}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource InkBrush}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="26,10,26,20">
                    <Button Content="{loc:Loc 以本次为基线}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            MinWidth="120"
                            Click="ApplyBaseline_Click" />
                    <Button Content="{loc:Loc 关闭}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            MinWidth="88"
                            Click="Close_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
