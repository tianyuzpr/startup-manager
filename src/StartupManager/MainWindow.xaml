<Window x:Class="StartupManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:StartupManager.Localization"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:StartupManager.Models"
        mc:Ignorable="d"
        Title="{Binding Converter={StaticResource AppInfo}, ConverterParameter=DisplayName}"
        Width="1360"
        Height="860"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Foreground="{DynamicResource InkBrush}"
        Background="{DynamicResource CanvasBrush}"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder"
            Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================= Sidebar ============================= -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource SidebarGradientStartColor}" Offset="0" />
                        <GradientStop Color="{DynamicResource SidebarGradientEndColor}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="92" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="22,24,18,0"
                                VerticalAlignment="Top">
                        <Border Width="44"
                                Height="44"
                                CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource LogoGradientStartColor}" Offset="0" />
                                    <GradientStop Color="{DynamicResource LogoGradientEndColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M13,1 L4,14 L10,14 L8,23 L18,10 L12,10 Z"
                                          Fill="{DynamicResource OnAccentBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,2,0,0">
                            <TextBlock Text="{Binding Converter={StaticResource AppInfo}, ConverterParameter=ProductName}"
                                       Foreground="{DynamicResource OnAccentBrush}"
                                       FontSize="19"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="STARTUP MANAGER"
                                       Foreground="{DynamicResource SidebarSecondaryForegroundBrush}"
                                       FontSize="8.5"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{loc:Loc 分类}"
                                   Foreground="{DynamicResource SidebarSectionForegroundBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="26,0,0,8" />

                        <RadioButton x:Name="NavAll"
                                     GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     Tag="All"
                                     IsChecked="True"
                                     Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8FD;"
                                           Style="{StaticResource IconText}"
                                           FontSize="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc 全部项目}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource SidebarBadgeBackgroundBrush}"
                                        CornerRadius="7"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalCount}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SidebarBadgeForegroundBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavServices"
                                     GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     Tag="WindowsServices"
                                     Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;"
                                           Style="{StaticResource IconText}"
                                           FontSize="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc Windows 服务}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource SidebarBadgeBackgroundBrush}"
                                        CornerRadius="7"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ServiceCount}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SidebarBadgeForegroundBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavLogin"
                                     GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     Tag="LoginStartup"
                                     Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7E8;"
                                           Style="{StaticResource IconText}"
                                           FontSize="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc 登录启动项}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource SidebarBadgeBackgroundBrush}"
                                        CornerRadius="7"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LoginCount}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SidebarBadgeForegroundBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavTasks"
                                     GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     Tag="ScheduledTasks"
                                     Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE787;"
                                           Style="{StaticResource IconText}"
                                           FontSize="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc 计划任务}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource SidebarBadgeBackgroundBrush}"
                                        CornerRadius="7"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TaskCount}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SidebarBadgeForegroundBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavDisabled"
                                     GroupName="Nav"
                                     Style="{StaticResource NavItem}"
                                     Tag="Disabled"
                                     Click="Nav_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE711;"
                                           Style="{StaticResource IconText}"
                                           FontSize="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc 已禁用项目}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource SidebarBadgeBackgroundBrush}"
                                        CornerRadius="7"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisabledCount}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SidebarBadgeForegroundBrush}" />
                                </Border>
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="16,16,16,14">
                        <Border Background="{DynamicResource SidebarCardBackgroundBrush}"
                                BorderBrush="{DynamicResource SidebarCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="9"
                                            Background="{DynamicResource SidebarIconBackgroundBrush}">
                                        <TextBlock Text="&#xE72E;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource SidebarIconForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AdminText}"
                                                   Foreground="{DynamicResource OnAccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AdminDetail}"
                                                   Foreground="{DynamicResource SidebarDetailForegroundBrush}"
                                                   FontSize="9.5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Click="Elevate_Click"
                                        Background="{DynamicResource SidebarAccentButtonBackgroundBrush}"
                                        Foreground="{DynamicResource OnAccentBrush}"
                                        FontSize="11"
                                        Padding="10,7"
                                        Margin="0,12,0,0"
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource PrimaryButton}"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{loc:Loc 以管理员身份重启}"
                                               Foreground="{DynamicResource OnAccentBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Button>

                                <Border Background="{DynamicResource SidebarSuccessBackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="8,6"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="{DynamicResource SidebarSuccessDotBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc 全部系统级功能已解锁}"
                                                   Foreground="{DynamicResource SidebarSuccessForegroundBrush}"
                                                   FontSize="10"
                                                   Margin="7,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Converter={StaticResource AppInfo}, ConverterParameter=Footer}"
                                   Foreground="{DynamicResource SidebarVersionForegroundBrush}"
                                   FontSize="9"
                                   Margin="4,14,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================= Main area ============================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid x:Name="HeaderBar"
                      Grid.Row="0"
                      Background="{DynamicResource HeaderBrush}"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Border BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1" />
                    <Grid Margin="28,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 启动项目}" Style="{StaticResource TitleText}" FontSize="20" />
                            <TextBlock Text="{Binding HeaderSummary}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBox Width="250" AutomationProperties.Name="{loc:Loc 搜索启动项}"
                                     Tag="{loc:Loc 搜索名称、命令、路径...}"
                                     Height="38"
                                     Style="{StaticResource SearchTextBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />

                            <Button Style="{StaticResource IconButton}"
                                    Width="38"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{loc:Loc 刷新列表}"
                                    Click="Refresh_Click"
                                    ToolTip="{loc:Loc 刷新列表（会重新读取所有启动项）}">
                                <TextBlock Text="&#xE72C;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15" />
                            </Button>

                            <Grid Margin="8,0,0,0">
                                <Button x:Name="DiffButton"
                                        Style="{StaticResource IconButton}"
                                        Width="38"
                                        Height="38"
                                        AutomationProperties.Name="{loc:Loc 查看启动项变更}"
                                        Click="Diff_Click"
                                        ToolTip="{loc:Loc 查看启动项变更}">
                                    <TextBlock Text="&#xE81C;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="15" />
                                </Button>
                                <Border x:Name="DiffBadge"
                                        Background="{DynamicResource DangerButtonBackgroundBrush}"
                                        CornerRadius="7"
                                        Padding="5,1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-4,-4,0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="DiffBadgeText"
                                               Text="0"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DangerButtonForegroundBrush}" />
                                </Border>
                            </Grid>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Padding="11,9"
                                    AutomationProperties.Name="{loc:Loc 导出当前列表为 CSV}"
                                    Click="Export_Click"
                                    ToolTip="{loc:Loc 把当前筛选结果导出为 CSV 文件}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource InkBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc 导出}"
                                               Foreground="{DynamicResource InkBrush}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0"
                                    Padding="15,9"
                                    AutomationProperties.Name="{loc:Loc 新增启动项}"
                                    Click="AddEntry_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource OnAccentBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc 新增启动项}"
                                               Foreground="{DynamicResource OnAccentBrush}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource IconButton}"
                                    Width="38"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{loc:Loc 打开设置}"
                                    Click="Settings_Click"
                                    ToolTip="{loc:Loc 设置}">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15" />
                            </Button>

                            <Button x:Name="ThemeToggleButton"
                                    Style="{StaticResource IconButton}"
                                    Width="38"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{loc:Loc 切换深色或浅色主题}"
                                    Click="ToggleTheme_Click"
                                    ToolTip="{loc:Loc 切换深色模式}">
                                <TextBlock x:Name="ThemeIconGlyph"
                                           Text="&#xE708;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15" />
                            </Button>

                            <Border Width="1"
                                    Height="22"
                                    Background="{DynamicResource LineBrush}"
                                    Margin="12,0,8,0" />

                            <Button Style="{StaticResource WindowControlButton}"
                                    AutomationProperties.Name="{loc:Loc 最小化}"
                                    Click="Minimize_Click"
                                    ToolTip="{loc:Loc 最小化}">
                                <TextBlock Text="&#xE921;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="11" />
                            </Button>
                            <Button x:Name="MaximizeButton"
                                    Style="{StaticResource WindowControlButton}"
                                    AutomationProperties.Name="{loc:Loc 最大化}"
                                    Click="Maximize_Click"
                                    ToolTip="{loc:Loc 最大化}">
                                <TextBlock x:Name="MaximizeGlyph"
                                           Text="&#xE922;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource CloseWindowButton}"
                                    AutomationProperties.Name="{loc:Loc 关闭窗口}"
                                    Click="Close_Click"
                                    ToolTip="{loc:Loc 关闭}">
                                <TextBlock Text="&#xE8BB;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="28,18,28,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="356" />
                    </Grid.ColumnDefinitions>

                    <!-- List column -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="StatusAll"
                                             GroupName="StatusFilter"
                                             Style="{StaticResource StatusChip}"
                                             Tag="All"
                                             IsChecked="True"
                                             Content="{loc:Loc 全部}"
                                             Click="Status_Click" />
                                <RadioButton GroupName="StatusFilter"
                                             Style="{StaticResource StatusChip}"
                                             Tag="Running"
                                             Content="{loc:Loc 运行中}"
                                             Margin="8,0,0,0"
                                             Click="Status_Click" />
                                <RadioButton GroupName="StatusFilter"
                                             Style="{StaticResource StatusChip}"
                                             Tag="Stopped"
                                             Content="{loc:Loc 未运行}"
                                             Margin="8,0,0,0"
                                             Click="Status_Click" />
                                <RadioButton GroupName="StatusFilter"
                                             Style="{StaticResource StatusChip}"
                                             Tag="Disabled"
                                             Content="{loc:Loc 已禁用}"
                                             Margin="8,0,0,0"
                                             Click="Status_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilteredCountText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="  ·  "
                                           FontSize="11"
                                           Foreground="{DynamicResource SubtleBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastScanText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubtleBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource WarningBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,9"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="13"
                                           Foreground="{DynamicResource WarningBrush}"
                                           VerticalAlignment="Top"
                                           Margin="0,1,8,0" />
                                <TextBlock Text="{Binding WarningText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="17" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <ListBox x:Name="EntriesList"
                                     Style="{StaticResource StartupList}"
                                     ItemsSource="{Binding EntriesView}"
                                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                     SelectionMode="Extended"
                                     SelectionChanged="EntriesList_SelectionChanged"
                                     Margin="0,0,2,0" />

                            <Border x:Name="BatchHint"
                                    Background="{DynamicResource PanelSecondaryBrush}"
                                    BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="9,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,8,0,0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="BatchHintText"
                                           FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </Border>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,36"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <Border Width="76"
                                        Height="76"
                                        CornerRadius="22"
                                        Background="{DynamicResource SoftAccentBrush}">
                                    <TextBlock Text="&#xE8FD;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="30"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding EmptyStateTitle}"
                                           Foreground="{DynamicResource InkBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,18,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyStateMessage}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,7,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <Border Background="{DynamicResource OverlayBrush}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                    CornerRadius="12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="150"
                                                 Height="4"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource ProgressTrackBrush}"
                                                 BorderThickness="0" />
                                    <TextBlock Text="{Binding BusyText}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Detail column -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Foreground="{DynamicResource InkBrush}"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel DataContext="{Binding SelectedEntry}" Margin="22,22,22,24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48"
                                                Height="48"
                                                CornerRadius="13"
                                                Style="{StaticResource KindTile}">
                                            <TextBlock Text="{Binding KindMonogram}"
                                                       Style="{StaticResource KindMonogram}"
                                                       FontSize="17" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="45" />
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Border Style="{StaticResource StatusPill}"
                                                CornerRadius="8"
                                                Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Style="{StaticResource StatusDot}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Style="{StaticResource StatusPillText}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource SoftWarningBrush}"
                                                CornerRadius="8"
                                                Padding="9,5"
                                                Margin="7,0,0,0"
                                                Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc 需要管理员}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="10" />
                                        </Border>
                                        <Border Background="{DynamicResource DisabledBadgeBackgroundBrush}"
                                                CornerRadius="8"
                                                Padding="9,5"
                                                Margin="7,0,0,0"
                                                Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{loc:Loc 已禁用}"
                                                       Foreground="{DynamicResource DisabledBadgeForegroundBrush}"
                                                       FontSize="10" />
                                        </Border>
                                    </StackPanel>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="DetailRestartButton"
                                                Grid.Column="0"
                                                Style="{StaticResource PrimaryButton}"
                                                AutomationProperties.Name="{loc:Loc 重启当前项目}"
                                                Click="RestartEntry_Click"
                                                IsEnabled="{Binding CanRestart}"
                                                Padding="8,9">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource OnAccentBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc 重启}"
                                                           Foreground="{DynamicResource OnAccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButton}"
                                                AutomationProperties.Name="{loc:Loc 停止或启动当前项目}"
                                                Click="PrimaryEntry_Click"
                                                IsEnabled="{Binding CanToggle}"
                                                Padding="8,9">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PrimaryActionGlyph}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PrimaryActionLabel}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4"
                                                Style="{StaticResource SecondaryButton}"
                                                AutomationProperties.Name="{loc:Loc 禁用或启用当前项目}"
                                                Click="ToggleEnabled_Click"
                                                IsEnabled="{Binding CanToggleEnabled}"
                                                ToolTip="{Binding ToggleEnabledToolTip}"
                                                Padding="8,9">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ToggleEnabledGlyph}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ToggleEnabledLabel}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="19"
                                               Margin="0,14,0,0" />

                                    <Border Background="{DynamicResource PanelSecondaryBrush}"
                                            BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14"
                                            Margin="0,16,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc 启动方式}" Style="{StaticResource CaptionText}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding StartupModeLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkBrush}" />
                                            </Grid>
                                            <Grid Margin="0,11,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc 作用范围}" Style="{StaticResource CaptionText}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ScopeLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkBrush}" />
                                            </Grid>
                                            <Grid Margin="0,11,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc 触发时机}" Style="{StaticResource CaptionText}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TriggerLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkBrush}" />
                                            </Grid>
                                            <Grid Margin="0,11,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc 进程}" Style="{StaticResource CaptionText}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProcessDisplay}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkBrush}" />
                                            </Grid>
                                            <Grid Margin="0,11,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc 匹配依据}" Style="{StaticResource CaptionText}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding MatchEvidence}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="16" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{loc:Loc 启动命令}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,16,0,6" />
                                    <Border Background="{DynamicResource PanelSecondaryBrush}"
                                            BorderBrush="{DynamicResource PanelSecondaryBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="11">
                                        <TextBlock Text="{Binding CommandDisplay}"
                                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource CodeTextBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="16" />
                                    </Border>

                                    <TextBlock Text="{loc:Loc 来源位置}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,14,0,6" />
                                    <TextBlock Text="{Binding LocationDisplay}"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="16" />

                                    <Border Background="{DynamicResource WarningBackgroundBrush}"
                                            BorderBrush="{DynamicResource WarningBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="10"
                                            Margin="0,14,0,0"
                                            Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ProtectedReason}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="16" />
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="{loc:Loc 打开文件位置}"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="10.5"
                                                Padding="10,7"
                                                Click="OpenLocation_Click"
                                                Visibility="{Binding CanOpenLocation, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="{loc:Loc 删除项目}"
                                                Style="{StaticResource DangerButton}"
                                                FontSize="10.5"
                                                Padding="10,7"
                                                Margin="8,0,0,0"
                                                Click="DeleteEntry_Click"
                                                IsEnabled="{Binding CanRequestDelete}" />
                                    </StackPanel>

                                    <TextBlock Text="{loc:Loc 删除前会自动保存一份项目快照到本地备份目录。}"
                                               Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="28"
                                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                                <Border Width="72"
                                        Height="72"
                                        CornerRadius="36"
                                        Background="{DynamicResource HoverBrush}">
                                    <TextBlock Text="&#xE8A5;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="26"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{loc:Loc 选择一个启动项目}"
                                           Foreground="{DynamicResource InkBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 在左侧点击项目，查看详细信息并执行操作。}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="220"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Toast -->
                <Border x:Name="ToastBorder"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,28"
                        Background="{DynamicResource ToastBackgroundBrush}"
                        CornerRadius="12"
                        Padding="16,11"
                        Opacity="0"
                        Visibility="Collapsed"
                        Panel.ZIndex="20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastIcon"
                                   Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ToastSuccessIconBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastText"
                                   Text=""
                                   Foreground="{DynamicResource ToastForegroundBrush}"
                                   FontSize="11.5"
                                   MaxWidth="620"
                                   TextWrapping="Wrap"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>

    <Window.Resources>
        <DataTemplate DataType="{x:Type models:ManagedEntry}">
            <Border x:Name="Card"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42"
                            Height="42"
                            CornerRadius="11"
                            Style="{StaticResource KindTile}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding KindMonogram}"
                                   Style="{StaticResource KindMonogram}"
                                   FontSize="15" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="13,0,14,0"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource InkBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="300"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource KindBadge}"
                                    CornerRadius="5"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindShortLabel}"
                                           Style="{StaticResource KindBadgeText}"
                                           FontSize="9" />
                            </Border>
                            <Border Background="{DynamicResource SoftWarningBrush}"
                                    CornerRadius="5"
                                    Padding="6,2"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc 需提权}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="9" />
                            </Border>
                            <Border Background="{DynamicResource DisabledBadgeBackgroundBrush}"
                                    CornerRadius="5"
                                    Padding="6,2"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{loc:Loc 已禁用}"
                                           Foreground="{DynamicResource DisabledBadgeForegroundBrush}"
                                           FontSize="9" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CommandDisplay}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource SubtleBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border Style="{StaticResource StatusPill}"
                                    CornerRadius="7"
                                    Padding="8,4"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5"
                                             Height="5"
                                             Style="{StaticResource StatusDot}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusLabel}"
                                               Style="{StaticResource StatusPillText}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ProcessLabel}"
                                       FontSize="8.5"
                                       Foreground="{DynamicResource SubtleBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,2,0"
                                       Visibility="{Binding ProcessLabel, Converter={StaticResource StringToVis}}" />
                        </StackPanel>

                        <Button Style="{StaticResource IconButton}"
                                AutomationProperties.Name="{loc:Loc 重启此项目}"
                                Click="RestartEntry_Click"
                                IsEnabled="{Binding CanRestart}"
                                ToolTip="{loc:Loc 重启 / 重新触发}"
                                Margin="1,0">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                AutomationProperties.Name="{loc:Loc 停止或启动此项目}"
                                Click="PrimaryEntry_Click"
                                IsEnabled="{Binding CanToggle}"
                                ToolTip="{Binding PrimaryActionLabel}"
                                Margin="1,0">
                            <TextBlock Text="{Binding PrimaryActionGlyph}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                AutomationProperties.Name="{loc:Loc 禁用或启用此项目}"
                                Click="ToggleEnabled_Click"
                                IsEnabled="{Binding CanToggleEnabled}"
                                ToolTip="{Binding ToggleEnabledToolTip}"
                                Margin="1,0">
                            <TextBlock Text="{Binding ToggleEnabledGlyph}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                AutomationProperties.Name="{loc:Loc 删除此项目}"
                                Click="DeleteEntry_Click"
                                IsEnabled="{Binding CanRequestDelete}"
                                Foreground="{DynamicResource DangerBrush}"
                                ToolTip="{loc:Loc 删除}"
                                Margin="1,0">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource RowSelectedBorderBrush}" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
</Window>
