<Project Sdk="Microsoft.NET.Sdk">

  <!-- All build-time facts (name, version, publisher, runtime) live in this file. -->
  <Import Project="..\..\build\app.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(AppTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>$(AppIconPath)</ApplicationIcon>
    <ApplicationManifest>$(AppManifestPath)</ApplicationManifest>
    <AssemblyName>$(AppAssemblyName)</AssemblyName>
    <RootNamespace>$(AppRootNamespace)</RootNamespace>
    <AssemblyTitle>$(AppDisplayName)</AssemblyTitle>
    <Product>$(AppDisplayName)</Product>
    <Description>$(AppDisplayName) · $(AppTaglineZh)</Description>
    <Company>$(AppCompany)</Company>
    <Copyright>$(AppCopyright)</Copyright>
    <Version>$(AppEffectiveVersion)</Version>
    <FileVersion>$(AppFileVersion)</FileVersion>
    <InformationalVersion>$(AppEffectiveVersion)</InformationalVersion>
    <RepositoryUrl>$(AppRepositoryUrl)</RepositoryUrl>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <PublishSingleFile>$(AppPublishSingleFile)</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>$(AppRuntimeIdentifier)</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same file is also embedded so the running app can read version and names. -->
    <EmbeddedResource Include="..\..\build\app.props"
                      Link="app.props"
                      LogicalName="StartupManager.app.props" />
  </ItemGroup>

</Project>
