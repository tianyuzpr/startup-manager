<!--
  Single source of truth for everything that changes between builds.

  Edit this file only. It is imported by src/StartupManager/StartupManager.csproj
  (MSBuild properties) and linked as an embedded resource for the app itself
  (footer version text, about info, generated task author).

  After editing, just run the normal build/publish command again.
-->
<Project>

  <!-- Shown in the window, footer, dialogs and file properties. -->
  <PropertyGroup>
    <AppDisplayName>启航 · 开机启动管理器</AppDisplayName>
    <AppProductName>启航</AppProductName>
    <AppTaglineZh>本地运行，数据不上传</AppTaglineZh>
    <AppTaglineEn>Local only, data stays on this PC</AppTaglineEn>
  </PropertyGroup>

  <!--
    Version rules (new scheme):
      stable:      vX.Y.Z-BUILDYYWW
      pre-release: vX.Y.0-rcZ-BUILDYYWW
      nightly:     YYwWWdDZ.NIGHTLY
      dev:         YYwWWdDZ

    Stable and pre-release builds append AppBuildNumber. Set AppBuildNumber to
    the ISO year/week of the release, for example BUILD2646 for ISO week 46 of
    2026. Dev and nightly builds must not carry a build number; their tags are
    generated by the workflow and override Version/InformationalVersion.

    AppVersion here is the semantic base, without -BUILDYYWW:
      stable:      1.5.0
      pre-release: 1.5.0-rc1
  -->
  <PropertyGroup>
    <AppReleaseChannel Condition="'$(AppReleaseChannel)' == ''">prerelease</AppReleaseChannel>
    <AppVersion>1.5.0-rc1</AppVersion>
    <AppFileVersion>1.5.0.0</AppFileVersion>

    <!--
      BUILDYYWW is the ISO year/week of the release, e.g. BUILD2646.
      Update it with AppVersion for stable/pre-release releases. Dev and
      nightly builds must leave it out of their version (the workflow does).
    -->
    <AppBuildNumber>BUILD2646</AppBuildNumber>

    <!-- Stable and pre-release only; dev/nightly never contain a build number. -->
    <AppEffectiveVersion Condition="'$(AppReleaseChannel)' == 'stable' or '$(AppReleaseChannel)' == 'prerelease'">$(AppVersion)-$(AppBuildNumber)</AppEffectiveVersion>
    <AppEffectiveVersion Condition="'$(AppEffectiveVersion)' == ''">$(AppVersion)</AppEffectiveVersion>
  </PropertyGroup>

  <!-- Publisher and legal metadata. -->
  <PropertyGroup>
    <AppCopyright>Copyright © 2026 Xiayue. Apache License 2.0.</AppCopyright>
    <AppRepositoryUrl>https://github.com/tianyuzpr/startup-manager</AppRepositoryUrl>
    <AppCompany>Xiayue</AppCompany>
  </PropertyGroup>

  <!-- Runtime and packaging facts. -->
  <PropertyGroup>
    <AppTargetFramework>net10.0-windows</AppTargetFramework>
    <AppRuntimeIdentifier>win-x64</AppRuntimeIdentifier>
    <AppSelfContained>true</AppSelfContained>
    <AppPublishReadyToRun>true</AppPublishReadyToRun>
    <AppPublishSingleFile>true</AppPublishSingleFile>
    <AppPublishDirectory>release</AppPublishDirectory>
    <AppMinimumWindows>Windows 10 1607 (build 14393) or later, x64</AppMinimumWindows>
  </PropertyGroup>

  <!-- Namespacing and assets. -->
  <PropertyGroup>
    <AppAssemblyName>StartupManager</AppAssemblyName>
    <AppRootNamespace>StartupManager</AppRootNamespace>
    <AppIconPath>Assets\app.ico</AppIconPath>
    <AppManifestPath>app.manifest</AppManifestPath>
  </PropertyGroup>

</Project>
